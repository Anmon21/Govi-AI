ANTHROPIC_API_KEY=your_api_key_here
APP_ENV=development
APP_PORT=8000
VAULT_PATH=/path/to/your/obsidian/vault/govi-content
DB_PATH=govi.db
FERNET_KEY=  # generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=  # generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=changeme
# Facebook OAuth — must match Meta App Dashboard registration exactly
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://yourapi.example.com/auth/facebook/callback
# Shared secret for the messenger-bot -> /internal/pages/{id}/access-token endpoint
INTERNAL_SECRET=  # generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
